---
source: tests/themes.rs
expression: "table(& built_in(\"catppuccin-latte\"))"
---
syntax_theme  base16-ocean.light

body                  fg #4c4f69       bg -
muted                 fg #bcc0cc       bg -
label                 fg -             bg -             bold
human_gutter          fg #8839ef       bg -             bold
assistant_gutter      fg #ea76cb       bg -             dim
tool_name             fg -             bg -             bold
tool_summary          fg -             bg -
tool_ok               fg #bcc0cc       bg -
tool_error            fg #d20f39       bg -
thinking              fg #bcc0cc       bg -
diff_added            fg #40a02b       bg -
diff_removed          fg #d20f39       bg -
diff_context          fg -             bg -
subagent              fg -             bg -             bold
injection             fg #bcc0cc       bg -
branch_marker         fg #bcc0cc       bg -
compact_divider       fg #bcc0cc       bg -
project_missing       fg #bcc0cc       bg -
session_live          fg #40a02b       bg -
heading               fg -             bg -             bold
strong                fg -             bg -             bold
emphasis              fg -             bg -             italic
strikethrough         fg -             bg -             crossed_out
inline_code           fg #8839ef       bg #ccd0da
code_block            fg -             bg #ccd0da
code_block_lang       fg #bcc0cc       bg #ccd0da
link                  fg #1e66f5       bg -             underline
quote                 fg #8c8fa1       bg -
quote_gutter          fg #bcc0cc       bg -
list_bullet           fg #bcc0cc       bg -
table_header          fg -             bg -             bold
table_border          fg #bcc0cc       bg -
rule                  fg #bcc0cc       bg -
html                  fg #bcc0cc       bg -
header_title          fg -             bg -             bold
status                fg -             bg -
status_notice         fg #df8e1d       bg -
status_error          fg #d20f39       bg -
cursor_line           fg -             bg #bcc0cc
search_match          fg black         bg #df8e1d
search_current        fg black         bg #ea76cb       bold
selection             fg #4c4f69       bg #acb0be
help_window           fg #4c4f69       bg #eff1f5
scroll_progress       fg #8839ef       bg -
hint                  fg #bcc0cc       bg -
column_title          fg #bcc0cc       bg -
column_title_active   fg #8839ef       bg -             bold
