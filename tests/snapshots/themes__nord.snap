---
source: tests/themes.rs
expression: "table(& built_in(\"nord\"))"
---
syntax_theme  base16-ocean.dark

body                  fg #d8dee9       bg -
muted                 fg #434c5e       bg -
label                 fg -             bg -             bold
human_gutter          fg #88c0d0       bg -             bold
assistant_gutter      fg #b48ead       bg -             dim
tool_name             fg #88c0d0       bg -             bold
tool_summary          fg #434c5e       bg -
tool_ok               fg #434c5e       bg -
tool_error            fg #bf616a       bg -
thinking              fg #434c5e       bg -
diff_added            fg #a3be8c       bg -
diff_removed          fg #bf616a       bg -
diff_context          fg -             bg -
subagent              fg -             bg -             bold
injection             fg #434c5e       bg -
branch_marker         fg #434c5e       bg -
compact_divider       fg #434c5e       bg -
project_missing       fg #434c5e       bg -
session_live          fg #a3be8c       bg -
heading               fg -             bg -             bold
strong                fg -             bg -             bold
emphasis              fg -             bg -             italic
strikethrough         fg -             bg -             crossed_out
inline_code           fg #88c0d0       bg #353c4a
code_block            fg -             bg #353c4a
code_block_lang       fg #434c5e       bg #353c4a
link                  fg #81a1c1       bg -             underline
quote                 fg #7b88a1       bg -
quote_gutter          fg #434c5e       bg -
list_bullet           fg #434c5e       bg -
table_header          fg -             bg -             bold
table_border          fg #434c5e       bg -
rule                  fg #434c5e       bg -
html                  fg #434c5e       bg -
header_title          fg -             bg -             bold
status                fg -             bg -
status_notice         fg #ebcb8b       bg -
status_error          fg #bf616a       bg -
cursor_line           fg -             bg #3b4252
search_match          fg black         bg #ebcb8b
search_current        fg black         bg #b48ead       bold
selection             fg #eceff4       bg #4c566a
help_window           fg #d8dee9       bg #2e3440
scroll_progress       fg #88c0d0       bg -
hint                  fg #434c5e       bg -
column_title          fg #434c5e       bg -
column_title_active   fg #88c0d0       bg -             bold
