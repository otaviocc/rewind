---
source: tests/themes.rs
expression: "table(& built_in(\"tokyo-night\"))"
---
syntax_theme  base16-ocean.dark

body                  fg #c0caf5       bg -
muted                 fg #414868       bg -
label                 fg -             bg -             bold
human_gutter          fg #7aa2f7       bg -             bold
assistant_gutter      fg #ff9e64       bg -             dim
tool_name             fg -             bg -             bold
tool_summary          fg -             bg -
tool_ok               fg #414868       bg -
tool_error            fg #f7768e       bg -
thinking              fg #414868       bg -
diff_added            fg #9ece6a       bg -
diff_removed          fg #f7768e       bg -
diff_context          fg -             bg -
subagent              fg -             bg -             bold
injection             fg #414868       bg -
branch_marker         fg #414868       bg -
compact_divider       fg #414868       bg -
project_missing       fg #414868       bg -
session_live          fg #9ece6a       bg -
heading               fg -             bg -             bold
strong                fg -             bg -             bold
emphasis              fg -             bg -             italic
strikethrough         fg -             bg -             crossed_out
inline_code           fg #7aa2f7       bg #1f2335
code_block            fg -             bg #1f2335
code_block_lang       fg #414868       bg #1f2335
link                  fg #bb9af7       bg -             underline
quote                 fg #565f89       bg -
quote_gutter          fg #414868       bg -
list_bullet           fg #414868       bg -
table_header          fg -             bg -             bold
table_border          fg #414868       bg -
rule                  fg #414868       bg -
html                  fg #414868       bg -
header_title          fg -             bg -             bold
status                fg -             bg -
status_notice         fg #e0af68       bg -
status_error          fg #f7768e       bg -
cursor_line           fg -             bg #292e42
search_match          fg black         bg #e0af68
search_current        fg black         bg #ff9e64       bold
selection             fg #c0caf5       bg #33467c
help_window           fg #c0caf5       bg #1a1b26
scroll_progress       fg #7aa2f7       bg -
hint                  fg #414868       bg -
column_title          fg #414868       bg -
column_title_active   fg #7aa2f7       bg -             bold
