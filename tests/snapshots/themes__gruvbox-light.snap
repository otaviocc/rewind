---
source: tests/themes.rs
expression: "table(& built_in(\"gruvbox-light\"))"
---
syntax_theme  base16-ocean.light

body                  fg #3c3836       bg -
muted                 fg #d5c4a1       bg -
label                 fg -             bg -             bold
human_gutter          fg #b57614       bg -             bold
assistant_gutter      fg #8f3f71       bg -             dim
tool_name             fg #b57614       bg -             bold
tool_summary          fg #d5c4a1       bg -
tool_ok               fg #d5c4a1       bg -
tool_error            fg #9d0006       bg -
thinking              fg #d5c4a1       bg -
diff_added            fg #79740e       bg -
diff_removed          fg #9d0006       bg -
diff_context          fg -             bg -
subagent              fg -             bg -             bold
injection             fg #d5c4a1       bg -
branch_marker         fg #d5c4a1       bg -
compact_divider       fg #d5c4a1       bg -
project_missing       fg #d5c4a1       bg -
session_live          fg #79740e       bg -
heading               fg -             bg -             bold
strong                fg -             bg -             bold
emphasis              fg -             bg -             italic
strikethrough         fg -             bg -             crossed_out
inline_code           fg #b57614       bg #f2e5bc
code_block            fg -             bg #f2e5bc
code_block_lang       fg #d5c4a1       bg #f2e5bc
link                  fg #076678       bg -             underline
quote                 fg #7c6f64       bg -
quote_gutter          fg #d5c4a1       bg -
list_bullet           fg #d5c4a1       bg -
table_header          fg -             bg -             bold
table_border          fg #d5c4a1       bg -
rule                  fg #d5c4a1       bg -
html                  fg #d5c4a1       bg -
header_title          fg #b57614       bg -             bold
status                fg #7c6f64       bg -
status_notice         fg #b57614       bg -
status_error          fg #9d0006       bg -
cursor_line           fg -             bg #ebdbb2
search_match          fg black         bg #b57614
selection             fg #282828       bg #bdae93
help_window           fg #3c3836       bg #fbf1c7
scroll_progress       fg #b57614       bg -
hint                  fg #d5c4a1       bg -
column_title          fg #d5c4a1       bg -
column_title_active   fg #b57614       bg -             bold
