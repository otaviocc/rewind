---
source: tests/themes.rs
expression: "table(& built_in(\"gruvbox-dark\"))"
---
syntax_theme  base16-eighties.dark

body                  fg #ebdbb2       bg -
muted                 fg #665c54       bg -
label                 fg -             bg -             bold
human_gutter          fg #fabd2f       bg -             bold
assistant_gutter      fg #d3869b       bg -             dim
tool_name             fg -             bg -             bold
tool_summary          fg -             bg -
tool_ok               fg #665c54       bg -
tool_error            fg #fb4934       bg -
thinking              fg #665c54       bg -
diff_added            fg #b8bb26       bg -
diff_removed          fg #fb4934       bg -
diff_context          fg -             bg -
subagent              fg -             bg -             bold
injection             fg #665c54       bg -
branch_marker         fg #665c54       bg -
compact_divider       fg #665c54       bg -
project_missing       fg #665c54       bg -
session_live          fg #b8bb26       bg -
heading               fg -             bg -             bold
strong                fg -             bg -             bold
emphasis              fg -             bg -             italic
strikethrough         fg -             bg -             crossed_out
inline_code           fg #fabd2f       bg #32302f
code_block            fg -             bg #32302f
code_block_lang       fg #665c54       bg #32302f
link                  fg #83a598       bg -             underline
quote                 fg #a89984       bg -
quote_gutter          fg #665c54       bg -
list_bullet           fg #665c54       bg -
table_header          fg -             bg -             bold
table_border          fg #665c54       bg -
rule                  fg #665c54       bg -
html                  fg #665c54       bg -
header_title          fg -             bg -             bold
status                fg -             bg -
status_notice         fg #fabd2f       bg -
status_error          fg #fb4934       bg -
cursor_line           fg -             bg #3c3836
search_match          fg black         bg #fabd2f
search_current        fg black         bg #d3869b       bold
selection             fg #fbf1c7       bg #504945
help_window           fg #ebdbb2       bg #282828
scroll_progress       fg #fabd2f       bg -
hint                  fg #665c54       bg -
column_title          fg #665c54       bg -
column_title_active   fg #fabd2f       bg -             bold
